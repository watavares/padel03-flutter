{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "padel03-prod",
          "appId": "1:595593582051:android:ea21ae50960ccf0ea0fcd6",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "padel03-prod",
          "configurations": {
            "android": "1:595593582051:android:ea21ae50960ccf0ea0fcd6",
            "ios": "1:595593582051:ios:16d79a31bc6ee204a0fcd6",
            "macos": "1:595593582051:ios:16d79a31bc6ee204a0fcd6",
            "web": "1:595593582051:web:af183d17976826cfa0fcd6",
            "windows": "1:595593582051:web:84948b1126f96127a0fcd6"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "hosting-dev",
      "public": "build/web-dev",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|woff2|woff|ttf|png|jpg|jpeg|gif|svg|ico|webp)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/flutter_service_worker.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    },
    {
